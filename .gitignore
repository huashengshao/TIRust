/target/
/.local/
**/*.profraw
**/*.profdata
.DS_Store

# Python reference-tool bytecode
__pycache__/
*.pyc

# Slimness policy (pyAmpliCol collaboration protocol, section 5, in
# docs/PYAMPLICOL-COLLABORATION.md): raw captures, raw JSON/JSONL, logs and
# generated PDFs are not committed here; they go to
# huashengshao/iregi-rust-evidence or to release assets. When code writes such
# output to a new path, add that path here in the same PR.
# docs/benchmark.pdf stays tracked (a slim summary, under 1 MiB, built from
# docs/benchmark-summary.typ by scripts/build-benchmark-report.sh).
*.log
*.log.gz
*.jsonl
*.jsonl.gz
*.pdf
!/docs/benchmark.pdf
# Report data and raw benchmark results (the old full report's docs/data/).
/docs/data/
# validation/ keeps only the fixtures that tests read and its README.md
# (scripts/keep-validation.txt); everything else written there (captures,
# payload archives, receipts, reports) is evidence.
/validation/**
!/validation/**/
!/validation/README.md
!/validation/physical/ggh-numerator-reference.json
!/validation/physical/madloop/fixtures/gghh-helicity-1.json
!/validation/physical/madloop/fixtures/gghhh-helicity-1.json
!/validation/physical/madloop/fixtures/gggg-up-helicity-1.json
!/validation/physical/gghh-tensor-reference.json
!/validation/physical/gghhh-cli-input.json
!/validation/reference/fixtures.json
!/validation/reference/snapping/reductions.json
!/validation/pv-high-rank/lightlike-feynman-parameters.json
!/validation/highpoint-seven-point-current-cargo/fixture.json
!/validation/generalized-pv/reference-capture.json
!/validation/generalized-pv/reference-mixed-capture.json
!/validation/generalized-pv/reference-complex-capture.json
!/validation/public-highpoint/fixture-conditioned_masses.json
!/validation/benchmark/opening-rank6-20261026/inputs.json
!/validation/benchmark/baseline-6b24c03-licensed/results.json
!/validation/collier-reference/timing-initial8/summary.json
